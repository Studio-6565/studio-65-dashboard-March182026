{
  "name": "Email Studio When Client Approves/Rejects",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"approval_status\") != null) and (.trigger.data.approval_status != \"pending\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ClientMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_studio_when_client_approves_rejects",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "clientNotifyEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "clientNotifyEmail"
  }
}