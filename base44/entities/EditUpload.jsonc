{
  "name": "EditUpload",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "editor_name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "e.g. v1, v2, Final"
    },
    "title": {
      "type": "string"
    },
    "link": {
      "type": "string",
      "description": "Video link (Vimeo, Drive, Dropbox, etc.)"
    },
    "notes": {
      "type": "string",
      "description": "Editor's notes on this version"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "revision_requested"
      ],
      "default": "pending_review"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "from_role": {
            "type": "string",
            "enum": [
              "studio",
              "editor"
            ]
          },
          "body": {
            "type": "string"
          },
          "timecode": {
            "type": "string",
            "description": "Optional timecode e.g. 0:32"
          },
          "ts": {
            "type": "string"
          },
          "read_by_editor": {
            "type": "boolean",
            "default": false
          },
          "read_by_studio": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "read_by_studio": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_id",
    "editor_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {},
    "write": {}
  }
}