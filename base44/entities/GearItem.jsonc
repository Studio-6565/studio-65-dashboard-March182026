{
  "name": "GearItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Camera",
        "Lens",
        "Audio",
        "Lighting",
        "Drone",
        "Stabilizer",
        "Storage",
        "Accessories",
        "Other"
      ],
      "default": "Other"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "Excellent",
        "Good",
        "Fair",
        "Needs Repair"
      ],
      "default": "Good"
    },
    "ownership": {
      "type": "string",
      "enum": [
        "Mine",
        "Borrowed",
        "Rental"
      ],
      "default": "Mine"
    },
    "owner_name": {
      "type": "string"
    },
    "vendor_contact_id": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number"
    },
    "rental_rate": {
      "type": "number",
      "description": "Daily rental rate when lending this item out"
    },
    "rental_rate_unit": {
      "type": "string",
      "enum": [
        "day",
        "half-day",
        "week"
      ],
      "default": "day"
    },
    "assigned_project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project IDs this gear is currently assigned to"
    },
    "maintenance_records": {
      "type": "array",
      "description": "Maintenance history and upcoming scheduled maintenance",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "service",
              "repair",
              "cleaning",
              "calibration",
              "inspection",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "next_due_date": {
            "type": "string",
            "format": "date"
          },
          "cost": {
            "type": "number"
          },
          "vendor": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "completed",
              "overdue"
            ],
            "default": "scheduled"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}