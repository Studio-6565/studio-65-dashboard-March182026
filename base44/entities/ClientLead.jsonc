{
  "name": "ClientLead",
  "type": "object",
  "properties": {
    "company": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "prospect",
        "proposal_sent",
        "negotiating",
        "won",
        "lost"
      ],
      "default": "prospect"
    },
    "project_type": {
      "type": "string"
    },
    "proposal_value": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "first_contact_date": {
      "type": "string",
      "format": "date"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled follow-up"
    },
    "proposal_sent_date": {
      "type": "string",
      "format": "date"
    },
    "closed_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "contact",
              "proposal",
              "follow_up",
              "status_change",
              "note"
            ]
          },
          "message": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "company",
    "contact_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}