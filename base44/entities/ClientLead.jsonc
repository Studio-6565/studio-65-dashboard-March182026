{
  "name": "ClientLead",
  "type": "object",
  "properties": {
    "company": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "prospect",
        "proposal_sent",
        "negotiating",
        "won",
        "lost"
      ],
      "default": "prospect"
    },
    "project_type": {
      "type": "string"
    },
    "proposal_value": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "first_contact_date": {
      "type": "string",
      "format": "date"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "proposal_sent_date": {
      "type": "string",
      "format": "date"
    },
    "closed_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "description": "Proposals built for this lead",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "shoot_type": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "terms": {
            "type": "string"
          },
          "markup_pct": {
            "type": "number",
            "default": 0
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "qty": {
                  "type": "number"
                },
                "unit_cost": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              }
            }
          },
          "subtotal": {
            "type": "number"
          },
          "markup_amount": {
            "type": "number"
          },
          "grand_total": {
            "type": "number"
          },
          "proposal_status": {
            "type": "string",
            "enum": [
              "draft",
              "sent",
              "viewed",
              "accepted",
              "rejected"
            ],
            "default": "draft"
          },
          "created_at": {
            "type": "string"
          },
          "sent_at": {
            "type": "string"
          },
          "accepted_at": {
            "type": "string"
          }
        }
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "contact",
              "proposal",
              "follow_up",
              "status_change",
              "note"
            ]
          },
          "message": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "company",
    "contact_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}