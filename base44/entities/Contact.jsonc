{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Crew",
          "Client",
          "Vendor",
          "Editor",
          "Other"
        ]
      }
    },
    "role": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "rate": {
      "type": "string"
    },
    "rate_type": {
      "type": "string",
      "enum": [
        "flat",
        "hourly"
      ],
      "default": "flat"
    },
    "notes": {
      "type": "string"
    },
    "portal_password": {
      "type": "string"
    },
    "offerings": {
      "type": "array",
      "description": "Items/gear this vendor offers for rent or sale",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          }
        }
      }
    },
    "crew_skills": {
      "type": "string"
    },
    "crew_experience": {
      "type": "string"
    },
    "crew_equipment": {
      "type": "string"
    },
    "crew_availability": {
      "type": "string"
    },
    "crew_instagram": {
      "type": "string"
    },
    "crew_portfolio": {
      "type": "string"
    },
    "client_company": {
      "type": "string"
    },
    "client_project_type": {
      "type": "string"
    },
    "client_budget": {
      "type": "string"
    },
    "client_how_found": {
      "type": "string"
    },
    "vendor_company": {
      "type": "string"
    },
    "vendor_service_area": {
      "type": "string"
    },
    "vendor_website": {
      "type": "string"
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "stars": {
            "type": "number"
          },
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}