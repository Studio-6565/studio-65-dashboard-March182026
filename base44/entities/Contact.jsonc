{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "is_test": {
      "type": "boolean",
      "default": false
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Crew",
          "Client",
          "Vendor",
          "Editor",
          "Other"
        ]
      }
    },
    "role": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "rate": {
      "type": "string"
    },
    "rate_type": {
      "type": "string",
      "enum": [
        "flat",
        "hourly"
      ],
      "default": "flat"
    },
    "notes": {
      "type": "string"
    },
    "portal_password": {
      "type": "string"
    },
    "referred_by_contact_id": {
      "type": "string"
    },
    "referred_by_name": {
      "type": "string"
    },
    "portal_users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "access_code": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "brand_profile": {
      "type": "object",
      "properties": {
        "primary_color": {
          "type": "string"
        },
        "secondary_color": {
          "type": "string"
        },
        "accent_color": {
          "type": "string"
        },
        "font_primary": {
          "type": "string"
        },
        "font_secondary": {
          "type": "string"
        },
        "tone_of_voice": {
          "type": "string"
        },
        "target_audience": {
          "type": "string"
        },
        "content_pillars": {
          "type": "string"
        },
        "competitors": {
          "type": "string"
        },
        "do_not_use": {
          "type": "string"
        },
        "logo_url": {
          "type": "string"
        },
        "brand_notes": {
          "type": "string"
        }
      }
    },
    "client_brain": {
      "type": "object",
      "description": "Full client brain data",
      "properties": {
        "website_url": {
          "type": "string"
        },
        "identity": {
          "type": "object",
          "properties": {
            "brand_voice_adjectives": {
              "type": "string",
              "description": "3-5 adjectives"
            },
            "tone_dos": {
              "type": "string"
            },
            "tone_donts": {
              "type": "string"
            },
            "banned_words": {
              "type": "string"
            },
            "signature_phrases": {
              "type": "string"
            },
            "point_of_view": {
              "type": "string"
            }
          }
        },
        "audience": {
          "type": "object",
          "properties": {
            "primary_demo": {
              "type": "string"
            },
            "psychographic": {
              "type": "string"
            },
            "pain_points": {
              "type": "string"
            },
            "desires": {
              "type": "string"
            },
            "objections": {
              "type": "string"
            }
          }
        },
        "content_pillars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "example_topics": {
                "type": "string"
              }
            }
          }
        },
        "performance_memory": {
          "type": "object",
          "properties": {
            "top_posts": {
              "type": "string",
              "description": "Pasted top 10 posts"
            },
            "winning_hooks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "winning_formats": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "handle": {
                "type": "string"
              },
              "what_they_do_well": {
                "type": "string"
              }
            }
          }
        },
        "compliance": {
          "type": "object",
          "properties": {
            "regulated_industry": {
              "type": "string"
            },
            "required_disclaimers": {
              "type": "string"
            },
            "restricted_language": {
              "type": "string"
            }
          }
        },
        "offer_stack": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "positioning_angle": {
                "type": "string"
              },
              "price": {
                "type": "string"
              }
            }
          }
        },
        "brain_versions": {
          "type": "array",
          "description": "Snapshot history",
          "items": {
            "type": "object",
            "properties": {
              "saved_at": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "snapshot": {
                "type": "string",
                "description": "JSON stringified brain"
              }
            }
          }
        }
      }
    },
    "offerings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          }
        }
      }
    },
    "crew_skills": {
      "type": "string"
    },
    "crew_experience": {
      "type": "string"
    },
    "crew_equipment": {
      "type": "string"
    },
    "crew_availability": {
      "type": "string"
    },
    "crew_instagram": {
      "type": "string"
    },
    "crew_portfolio": {
      "type": "string"
    },
    "client_company": {
      "type": "string"
    },
    "client_project_type": {
      "type": "string"
    },
    "client_budget": {
      "type": "string"
    },
    "client_how_found": {
      "type": "string"
    },
    "vendor_company": {
      "type": "string"
    },
    "vendor_service_area": {
      "type": "string"
    },
    "vendor_website": {
      "type": "string"
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "stars": {
            "type": "number"
          },
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {},
    "write": {}
  }
}