{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "Marks this as test/dev data \u2014 hidden from the live Portal"
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Crew",
          "Client",
          "Vendor",
          "Editor",
          "Other"
        ]
      }
    },
    "role": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "rate": {
      "type": "string"
    },
    "rate_type": {
      "type": "string",
      "enum": [
        "flat",
        "hourly"
      ],
      "default": "flat"
    },
    "notes": {
      "type": "string"
    },
    "portal_password": {
      "type": "string"
    },
    "referred_by_contact_id": {
      "type": "string",
      "description": "Contact ID of the client who referred this client"
    },
    "referred_by_name": {
      "type": "string",
      "description": "Denormalised name of the referring client"
    },
    "portal_users": {
      "type": "array",
      "description": "Additional staff/team members who can access this client's portal",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "access_code": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "e.g. Marketing Manager, Owner"
          }
        }
      }
    },
    "brand_profile": {
      "type": "object",
      "description": "Client brand guidelines and identity",
      "properties": {
        "primary_color": {
          "type": "string"
        },
        "secondary_color": {
          "type": "string"
        },
        "accent_color": {
          "type": "string"
        },
        "font_primary": {
          "type": "string"
        },
        "font_secondary": {
          "type": "string"
        },
        "tone_of_voice": {
          "type": "string"
        },
        "target_audience": {
          "type": "string"
        },
        "content_pillars": {
          "type": "string"
        },
        "competitors": {
          "type": "string"
        },
        "do_not_use": {
          "type": "string"
        },
        "logo_url": {
          "type": "string"
        },
        "brand_notes": {
          "type": "string"
        }
      }
    },
    "offerings": {
      "type": "array",
      "description": "Items/gear this vendor offers for rent or sale",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          }
        }
      }
    },
    "crew_skills": {
      "type": "string"
    },
    "crew_experience": {
      "type": "string"
    },
    "crew_equipment": {
      "type": "string"
    },
    "crew_availability": {
      "type": "string"
    },
    "crew_instagram": {
      "type": "string"
    },
    "crew_portfolio": {
      "type": "string"
    },
    "client_company": {
      "type": "string"
    },
    "client_project_type": {
      "type": "string"
    },
    "client_budget": {
      "type": "string"
    },
    "client_how_found": {
      "type": "string"
    },
    "vendor_company": {
      "type": "string"
    },
    "vendor_service_area": {
      "type": "string"
    },
    "vendor_website": {
      "type": "string"
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "stars": {
            "type": "number"
          },
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {},
    "write": {}
  }
}