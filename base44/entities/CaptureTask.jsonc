{
  "name": "CaptureTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "raw_input": {
      "type": "string"
    },
    "audio_url": {
      "type": "string",
      "description": "URL to raw audio file"
    },
    "transcript": {
      "type": "string",
      "description": "Full Whisper transcript"
    },
    "who_asked": {
      "type": "string"
    },
    "who_asked_contact_id": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "client_contact_id": {
      "type": "string"
    },
    "linked_project_id": {
      "type": "string"
    },
    "linked_project_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "deliverable",
        "decision",
        "follow-up",
        "errand",
        "admin",
        "note"
      ]
    },
    "effort": {
      "type": "string",
      "enum": [
        "15min",
        "30min",
        "1hr",
        "half-day",
        "full-day"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P1",
        "P2",
        "P3"
      ],
      "default": "P2"
    },
    "status": {
      "type": "string",
      "enum": [
        "inbox",
        "needs_input",
        "snoozed",
        "done",
        "converted"
      ],
      "default": "inbox"
    },
    "confidence": {
      "type": "number",
      "description": "0-100 AI confidence score"
    },
    "parse_source": {
      "type": "string",
      "enum": [
        "text",
        "voice",
        "image"
      ],
      "default": "text"
    },
    "parse_flag": {
      "type": "string",
      "enum": [
        "auto-parsed",
        "review",
        "needs_input",
        "unparsed"
      ],
      "description": "Parsing quality flag"
    },
    "transcript_snippet": {
      "type": "string",
      "description": "Relevant portion of transcript for this task"
    },
    "snooze_until": {
      "type": "string",
      "format": "date"
    },
    "roll_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this task has been auto-deferred"
    },
    "stale_flagged": {
      "type": "boolean",
      "default": false,
      "description": "True if item has been in needs_input > 7 days"
    },
    "clarifying_question": {
      "type": "string"
    },
    "clarifying_answer": {
      "type": "string"
    },
    "voice_capture_id": {
      "type": "string",
      "description": "Reference to VoiceCapture record"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}