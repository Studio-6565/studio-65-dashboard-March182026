{
  "name": "Contract",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "client",
        "crew",
        "retainer"
      ],
      "default": "client"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "signed",
        "declined",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "draft"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Full contract text / HTML"
    },
    "signed_at": {
      "type": "string"
    },
    "signature_name": {
      "type": "string"
    },
    "declined_at": {
      "type": "string"
    },
    "decline_reason": {
      "type": "string"
    },
    "sent_at": {
      "type": "string"
    },
    "retainer_monthly_hours": {
      "type": "number",
      "description": "Monthly hours bucket"
    },
    "retainer_monthly_fee": {
      "type": "number",
      "description": "Monthly fee in dollars"
    },
    "retainer_start_date": {
      "type": "string",
      "format": "date"
    },
    "retainer_renewal_date": {
      "type": "string",
      "format": "date"
    },
    "retainer_auto_renew": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}