{
  "name": "Project",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "is_test": {
      "type": "boolean",
      "default": false
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "extra_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "poc_name": {
      "type": "string"
    },
    "poc_phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Booked",
        "In Production",
        "In Edit",
        "Delivered",
        "Feedback Requested",
        "Invoiced"
      ],
      "default": "Booked"
    },
    "preprod_checklist": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "crew_cost": {
      "type": "number",
      "default": 0
    },
    "rental_cost": {
      "type": "number",
      "default": 0
    },
    "net": {
      "type": "number",
      "default": 0
    },
    "paid": {
      "type": "boolean",
      "default": false
    },
    "invoice_status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "paid",
        "partially_paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_due_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_number": {
      "type": "string"
    },
    "track_hours": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "default": ""
    },
    "call_sheet_url": {
      "type": "string"
    },
    "retainer_contract_id": {
      "type": "string",
      "description": "Contract ID of the retainer this project is billed against"
    },
    "retainer_contract_name": {
      "type": "string",
      "description": "Denormalised retainer name"
    },
    "crew": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "rate_type": {
            "type": "string",
            "enum": [
              "flat",
              "hourly",
              "daily",
              "project"
            ],
            "default": "flat"
          },
          "cost": {
            "type": "number"
          },
          "hours": {
            "type": "number"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "paid": {
            "type": "boolean"
          },
          "avail": {
            "type": "string",
            "enum": [
              "pending",
              "yes",
              "no"
            ],
            "default": "pending"
          },
          "portal_note": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "rentals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "equipment": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          },
          "qty": {
            "type": "number",
            "default": 1
          },
          "total_cost": {
            "type": "number"
          },
          "rate_type": {
            "type": "string",
            "enum": [
              "flat",
              "daily",
              "hourly",
              "project"
            ],
            "default": "flat"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "paid": {
            "type": "boolean"
          },
          "pickup_date": {
            "type": "string"
          },
          "return_date": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "expenses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "desc": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "Travel",
              "Food",
              "Props",
              "Software",
              "Printing",
              "Other"
            ]
          },
          "amount": {
            "type": "number"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          },
          "due": {
            "type": "string"
          },
          "link": {
            "type": "string"
          }
        }
      }
    },
    "shot_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "equipment_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "needed",
              "packed",
              "used",
              "returned",
              "missing"
            ],
            "default": "needed"
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "properties": {
        "arrival_time": {
          "type": "string"
        },
        "camera_orientation": {
          "type": "string"
        },
        "frame_rate": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "codec": {
          "type": "string"
        },
        "color_profile": {
          "type": "string"
        },
        "gear": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "photo_format": {
          "type": "string"
        },
        "photo_aspect": {
          "type": "string"
        },
        "photo_raw": {
          "type": "boolean"
        },
        "photo_dual_camera": {
          "type": "boolean"
        },
        "photo_flash": {
          "type": "boolean"
        }
      }
    },
    "hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "desc": {
            "type": "string"
          },
          "person": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string"
          },
          "ts": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "client"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {},
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {}
  }
}